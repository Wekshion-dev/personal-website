---
import '../styles/global.css';
import Sidebar from '../components/Sidebar.astro';

interface Props {
    title?: string;
}

const { title = 'Wekshion' } = Astro.props;
---

<!DOCTYPE html>

<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>{title}</title>
</head>

<body>
    <div class="container">
        <Sidebar />
        <slot />
    </div>
</body>
</html>